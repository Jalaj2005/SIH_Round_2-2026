{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pipeline Alert",
  "type": "object",
  "required": ["alert_id", "timestamp", "flow_id", "threat_class", "confidence", "severity", "evidence"],
  "properties": {
    "alert_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "flow_id": {"type": "string"},
    "threat_class": {"type": "string", "example": "reconnaissance_port_scan"},
    "sub_type": {"type": "string", "enum": ["horizontal_scan", "vertical_scan", "combined_scan"]},
    "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "src_ip": {"type": "string"},
    "window_seconds": {"type": "number"},
    "evidence": {
      "type": "object",
      "properties": {
        "unique_dst_ips": {"type": "integer"},
        "unique_ports_scanned": {"type": "integer"},
        "max_ports_single_dst": {"type": "integer"},
        "connection_attempts": {"type": "integer"},
        "failed_connections": {"type": "integer"},
        "failed_ratio": {"type": "number"},
        "top_targets": {"type": "array"}
      }
    },
    "module": {"type": "string"}
  }
}
